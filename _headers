# ==========================================================================
# Cloudflare Pages - Enterprise Security, Performance & Caching Blueprint
# Production Domain: https://prideworld.city/
# OWASP Top 10 Compliant | Google Core Web Vitals Optimized
# ==========================================================================

/*
  # 1. HTTP Strict Transport Security (HSTS) - 2 Years + Subdomains + Preload
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

  # 2. Prevent MIME-Type Sniffing Attacks
  X-Content-Type-Options: nosniff

  # 3. Clickjacking Protection
  X-Frame-Options: SAMEORIGIN

  # 4. Strict Referrer Privacy Policy
  Referrer-Policy: strict-origin-when-cross-origin

  # 5. Legacy XSS Filter Protection
  X-XSS-Protection: 1; mode=block

  # 6. Granular Hardware & Browser Feature Permissions Policy
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), cross-origin-isolated=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), keyboard-map=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(self), publickey-credentials-get=(), screen-wake-lock=(), sync-xhr=(), usb=(), xr-spatial-tracking=()

  # 7. Cross-Origin Security Policies
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Resource-Policy: same-origin

  # 8. Enterprise Content Security Policy (CSP)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; img-src 'self' data: https: blob:; media-src 'self' data: blob:; connect-src 'self' https:; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https:; upgrade-insecure-requests;

  # 9. Google & Bing Indexing Directives Header
  X-Robots-Tag: all, index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1

# ==========================================================================
# Static Asset Caching Architecture (RFC 9111 & Cloudflare Tiered Cache)
# ==========================================================================

# 1-Year Immutable Cache for Static Images, Fonts, SVG, and Icons
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
  Access-Control-Allow-Origin: *

# Weekly Cache with Background Stale-While-Revalidate for CSS
/css/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff
  Access-Control-Allow-Origin: *

# Weekly Cache with Background Stale-While-Revalidate for JS
/js/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff
  Access-Control-Allow-Origin: *

# Daily Cache with Hourly Revalidation for Township Datasets
/data/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600
  X-Content-Type-Options: nosniff
  Access-Control-Allow-Origin: *

# Immediate Freshness for HTML Entrypoints
/*.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff

# Manifest & Sitemap Cache
/sitemap.xml
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600
  Content-Type: text/plain; charset=utf-8

/site.webmanifest
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Content-Type: application/manifest+json; charset=utf-8

# Generative Engine Optimization (GEO) AI Grounding Files
/llms.txt
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
  X-Robots-Tag: all, index, follow

/llms-full.txt
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
  X-Robots-Tag: all, index, follow

/feed.xml
  Cache-Control: public, max-age=3600, stale-while-revalidate=1800
  Content-Type: application/rss+xml; charset=utf-8
  Access-Control-Allow-Origin: *
