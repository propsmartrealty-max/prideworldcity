# ==========================================================================
# Cloudflare Pages - Enterprise Security & Performance Hardening
# Domain: https://prideworld.city/
# ==========================================================================

/*
  # Enforce HTTPS with HSTS Preload
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Prevent MIME type sniffing
  X-Content-Type-Options: nosniff

  # Prevent clickjacking attacks
  X-Frame-Options: SAMEORIGIN

  # Referrer policy privacy protection
  Referrer-Policy: strict-origin-when-cross-origin

  # Restrict browser APIs and hardware access
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()

  # Cross-origin isolation policies
  Cross-Origin-Opener-Policy: same-origin-allow-popups

  # Comprehensive Content Security Policy (CSP)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https: blob:; media-src 'self' data: blob:; connect-src 'self' https:; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https:;

# Aggressive immutable caching for static assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Weekly cache for CSS with background stale revalidation
/css/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff

# Weekly cache for JS with background stale revalidation
/js/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff

# Daily cache for township data
/data/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600
  X-Content-Type-Options: nosniff
